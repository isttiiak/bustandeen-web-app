{
  "name": "bustandeen-frontend",
  "version": "5.114.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.ssr.config.ts && node scripts/prerender.mjs && node scripts/check-csp.mjs",
    "preview": "vite preview",
    "lint": "cd .. && eslint frontend --config eslint.config.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.e2e.json",
    "data:cities": "node scripts/build-cities.mjs && node scripts/build-place-index.mjs",
    "quran:text": "node scripts/build-quran-text.mjs",
    "og:image": "node scripts/generate-og-image.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "pwa:screenshots": "node scripts/capture-pwa-screenshots.mjs",
    "i18n:check": "node scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/el-messiri": "^5.3.0",
    "@fontsource/hind-siliguri": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/scheherazade-new": "^5.3.0",
    "@heroicons/react": "^2.2.0",
    "@tanstack/query-async-storage-persister": "^5.104.1",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-query-devtools": "^5.104.1",
    "@tanstack/react-query-persist-client": "^5.104.1",
    "adhan": "^4.4.6",
    "axios": "^1.20.0",
    "canvas-confetti": "^1.9.4",
    "daisyui": "^4.12.10",
    "firebase": "^12.19.0",
    "framer-motion": "^14.0.0",
    "html-to-image": "^1.11.13",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.1",
    "react-i18next": "^17.0.15",
    "react-router": "^7.18.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.0.3",
    "all-the-cities": "^3.1.0",
    "autoprefixer": "^10.6.1",
    "baseline-browser-mapping": "^2.11.27",
    "eslint": "^10.12.0",
    "geo-tz": "^8.1.9",
    "postcss": "^8.5.28",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5"
  },
  "allowScripts": {
    "esbuild": true,
    "@firebase/util": false,
    "protobufjs": false
  }
}
