# Server
PORT=5000
# Allow multiple origins separated by commas
FRONTEND_ORIGIN=http://localhost:5173

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<db-name>?retryWrites=true&w=majority&appName=Cluster0

# Firebase Admin SDK (Service Account)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Important: keep quoted; escape newlines as \n
FIREBASE_PRIVATE_KEY=""

# Groq API key for Naseeh AI companion (free tier)
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Field-level encryption key (AES-256-GCM) for Rayhanah wellness notes and a
# user's own saved Groq API key. Base64-encoded 32-byte key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing/rotating this key makes existing encrypted data undecryptable.
FIELD_ENCRYPTION_KEY=

# Dev only: bypass Firebase verification (0 or 1)
DEV_AUTH_BYPASS=0

# Sadaqah (donation) system — personal MFS number shown publicly on the
# donate page. Only bKash is live for BD Phase 1; Nagad is scaffolded-disabled.
SADAQAH_BKASH_NUMBER=
SADAQAH_NAGAD_NUMBER=

# Admin panel — direct email+password login, completely separate from the
# app's Firebase user accounts (POST /api/admin/auth/login). No Firebase
# account needs to exist for either address. ADMIN_EMAILS is the full
# allowlist; ADMIN_OWNER_EMAILS is the subset (normally a single address) that
# may also delete records, edit financial stats, or trigger bulk operations —
# every other admin gets the routine review workflow only (verify/reject a
# donation, approve/reject a zikr request). ADMIN_SESSION_SECRET signs the
# resulting session token (any long random string; rotating it logs every
# admin out).
ADMIN_EMAILS=istiak@bustandeen.com,ansar@bustandeen.com
ADMIN_OWNER_EMAILS=istiak@bustandeen.com
ADMIN_PANEL_PASSWORD=
ADMIN_SESSION_SECRET=

# Inbox that gets notified when a user submits a new zikr/dua suggestion for
# review (Zikr Library → "Make a request"). Defaults to ansar@bustandeen.com.
ZIKR_REQUEST_REVIEW_EMAIL=ansar@bustandeen.com

# Zoho SMTP — donation received/verified/rejected emails and the zikr-request
# review pipeline, sent as sadaqah@bustandeen.com. ZOHO_SMTP_PASS is a Zoho
# App-Specific Password (Zoho Mail → Security → App Passwords), not the
# account login password. ZOHO_SMTP_HOST/PORT are shared by every mailbox
# below (same Zoho org) — only the user/pass differ per mailbox.
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=
ZOHO_SMTP_PASS=

# istiak@bustandeen.com — used only for the one-time welcome email, so it
# reads as a real person, not a system mailbox. Needs its own Zoho
# App-Specific Password (same Zoho Mail → Security → App Passwords flow).
ISTIAK_SMTP_USER=
ISTIAK_SMTP_PASS=
