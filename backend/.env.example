# Server
PORT=5000
# Allow multiple origins separated by commas
FRONTEND_ORIGIN=http://localhost:5173

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<db-name>?retryWrites=true&w=majority&appName=Cluster0

# Firebase Admin SDK (Service Account)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Important: keep quoted; escape newlines as \n
FIREBASE_PRIVATE_KEY=""

# Groq API key for Naseeh AI companion (free tier)
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Field-level encryption key (AES-256-GCM) for Rayhanah wellness notes and a
# user's own saved Groq API key. Base64-encoded 32-byte key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing/rotating this key makes existing encrypted data undecryptable.
FIELD_ENCRYPTION_KEY=

# Dev only: bypass Firebase verification (0 or 1)
DEV_AUTH_BYPASS=0

# Sadaqah (donation) system — personal MFS number shown publicly on the
# donate page. Only bKash is live for BD Phase 1; Nagad is scaffolded-disabled.
SADAQAH_BKASH_NUMBER=
SADAQAH_NAGAD_NUMBER=

# Admin panel nav-link convenience only (Navbar shows an "Admin" link on a
# normal user's own profile if their email is on this list) — NOT the real
# admin gate. Harmless to leave broad.
ADMIN_EMAILS=istiak@bustandeen.com,ansar@bustandeen.com

# Admin panel's REAL auth: real Firebase accounts, verified via Firebase
# Admin SDK on every request, gated against the AdminAccount collection
# (role: 'servant' | 'ansar'). These four vars are ONLY used to bootstrap the
# very first Servant + Ansar accounts on a fresh deploy — the Firebase user is
# created if missing and an AdminAccount row is added; an email already
# present in AdminAccount is left untouched (passwords are never reset by
# this). After bootstrap, the Servant adds every further Ansar from inside
# the admin panel itself (Manage Ansars) — these bootstrap password vars can
# be removed/rotated once the initial sign-in succeeds.
SERVANT_EMAIL=istiak@bustandeen.com
SERVANT_BOOTSTRAP_PASSWORD=
ANSAR_EMAIL=ansar@bustandeen.com
ANSAR_BOOTSTRAP_PASSWORD=

# Inbox that gets notified when a user submits a new zikr/dua suggestion for
# review (Zikr Library → "Make a request"). Defaults to ansar@bustandeen.com.
ZIKR_REQUEST_REVIEW_EMAIL=ansar@bustandeen.com

# Zoho SMTP — three real mailboxes, one dedicated env-var pair each (same
# naming convention for all three, no shared/legacy fallback). ZOHO_SMTP_HOST/
# PORT are the only genuinely shared values (one Zoho server for the whole
# org). Each *_PASS is a Zoho App-Specific Password (Zoho Mail → Security →
# App Passwords), never the account login password. Both user and pass in a
# pair are required together — setting only one leaves that sender
# unconfigured (sends are skipped, never silently misattributed to another
# mailbox). Check /admin/ops-health (Servant-only) for a live per-sender
# configured/unconfigured status and a warning if two pairs ever resolve to
# the same address by mistake.
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465

# sadaqah@bustandeen.com — donation received/verified/rejected emails.
SADAQAH_SMTP_USER=
SADAQAH_SMTP_PASS=

# ansar@bustandeen.com — zikr-request review and feedback/contact replies.
ANSAR_SMTP_USER=
ANSAR_SMTP_PASS=

# istiak@bustandeen.com — the one-time welcome email only, so it reads as a
# real person, not a system mailbox.
ISTIAK_SMTP_USER=
ISTIAK_SMTP_PASS=
