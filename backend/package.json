{
  "name": "bustandeen-backend",
  "version": "5.138.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "cd .. && eslint backend --config eslint.config.js",
    "typecheck": "tsc --noEmit",
    "sync-indexes": "tsx src/scripts/syncIndexes.ts",
    "migrate:social-visibility": "tsx src/scripts/migrateSocialVisibility.ts",
    "cleanup:orphans": "tsx src/scripts/cleanupOrphans.ts",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules NODE_ENV=test jest --runInBand"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^12.6.0",
    "helmet": "^8.3.0",
    "imapflow": "^2.2.5",
    "mailparser": "^3.9.35",
    "mongoose": "^9.10.4",
    "morgan": "^1.12.1",
    "nodemailer": "^10.0.7",
    "pdf-lib": "^1.17.1",
    "qrcode-generator": "^2.0.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3.9.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26",
    "@types/nodemailer": "^8.0.2",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.5",
    "eslint": "^10.12.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "he": "^1.2.0"
  },
  "allowScripts": {
    "mongodb-memory-server": true,
    "esbuild": true,
    "@parcel/watcher": false,
    "protobufjs": false,
    "unrs-resolver": false
  }
}
