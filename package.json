{
  "name": "bustandeen",
  "version": "5.190.51",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11",
      "onFail": "error"
    }
  },
  "scripts": {
    "predev": "node scripts/check-deps.mjs",
    "dev": "npm run dev --prefix backend & npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "sync-deps": "npm ci && npm ci --prefix backend && npm ci --prefix frontend && node backend/node_modules/mongodb-memory-server/postinstall.js",
    "check-deps": "node scripts/check-deps.mjs",
    "lint": "npm run lint --prefix backend && npm run lint --prefix frontend && npm run lint:api",
    "lint:api": "eslint api --config eslint.config.js",
    "typecheck": "npm run typecheck --prefix backend && npm run typecheck --prefix frontend && npm run typecheck:api",
    "typecheck:api": "backend/node_modules/.bin/tsc -p api/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.2.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1"
  }
}
